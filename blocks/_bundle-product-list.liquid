{% liquid
  assign bundle_products = block.settings.products
  assign bundle_source_collection = block.settings.collection
  if bundle_products == blank and bundle_source_collection != blank
    assign bundle_products = bundle_source_collection.products
  endif

  assign bundle_max_products = block.settings.max_products | default: 9 | plus: 0
  if bundle_max_products < 1 or bundle_max_products > 16
    assign bundle_max_products = 9
  endif
  assign bundle_products_are_placeholders = false
  if bundle_products == blank and request.design_mode
    assign bundle_products = (1..bundle_max_products)
    assign bundle_products_are_placeholders = true
  endif

  assign bundle_layout = block.settings.layout_type | default: 'carousel'
  unless bundle_layout == 'grid' or bundle_layout == 'carousel'
    assign bundle_layout = 'carousel'
  endunless
  assign bundle_layout_mobile = bundle_layout
  if block.settings.customize_mobile_layout
    assign bundle_layout_mobile = block.settings.layout_type_mobile | default: bundle_layout
  endif
  assign bundle_has_carousel = false
  if bundle_layout == 'carousel' or bundle_layout_mobile == 'carousel'
    assign bundle_has_carousel = true
  endif

  assign bundle_columns_desktop = block.settings.desktop_columns | default: 3 | plus: 0
  assign bundle_columns_mobile = block.settings.mobile_columns | default: 2 | plus: 0
  if bundle_columns_desktop < 1 or bundle_columns_desktop > 6
    assign bundle_columns_desktop = 3
  endif
  if bundle_columns_mobile < 1 or bundle_columns_mobile > 6
    assign bundle_columns_mobile = 1
  endif

  assign bundle_products_aria_label = 'bundle_builder.products' | t

  assign bundle_variant_picker_type = block.settings.variant_picker_type | default: 'button'
  unless bundle_variant_picker_type == 'button' or bundle_variant_picker_type == 'dropdown'
    assign bundle_variant_picker_type = 'button'
  endunless
  assign bundle_variant_picker_type_mobile = block.settings.variant_picker_type_mobile | default: bundle_variant_picker_type
  unless bundle_variant_picker_type_mobile == 'button' or bundle_variant_picker_type_mobile == 'dropdown'
    assign bundle_variant_picker_type_mobile = bundle_variant_picker_type
  endunless
  if bundle_variant_picker_type == 'dropdown'
    assign bundle_variant_picker_type_mobile = 'dropdown'
  endif

  assign bundle_product_swatch_type = settings.product_card_swatch_type | default: settings.swatch_style | default: 'color'
  assign bundle_product_swatch_selected_style = settings.product_card_swatch_selected_style | default: 'border'
  unless bundle_product_swatch_selected_style == 'border' or bundle_product_swatch_selected_style == 'underline'
    assign bundle_product_swatch_selected_style = 'border'
  endunless
  assign bundle_product_swatch_width_desktop = settings.product_card_swatch_width_desktop | default: 30 | plus: 0
  assign bundle_product_swatch_width_mobile = settings.product_card_swatch_width_mobile | default: bundle_product_swatch_width_desktop | plus: 0
  assign bundle_product_swatch_height_ratio = '3 / 1'
  case settings.product_card_swatch_ratio
    when '1_1'
      assign bundle_product_swatch_height_ratio = '1 / 1'
    when '3_2'
      assign bundle_product_swatch_height_ratio = '3 / 2'
    when '2_1'
      assign bundle_product_swatch_height_ratio = '2 / 1'
    when '3_1'
      assign bundle_product_swatch_height_ratio = '3 / 1'
  endcase
  assign bundle_controls_navigation_position = block.settings.navigation_position | default: 'inside'
  unless bundle_controls_navigation_position == 'inside' or bundle_controls_navigation_position == 'outside' or bundle_controls_navigation_position == 'top'
    assign bundle_controls_navigation_position = 'inside'
  endunless

  assign bundle_controls_navigation_style = block.settings.navigation_style | default: 'secondary'
  if bundle_controls_navigation_style == 'tertiary'
    assign bundle_controls_navigation_style = 'icon_only'
  endif
  unless bundle_controls_navigation_style == 'primary' or bundle_controls_navigation_style == 'secondary' or bundle_controls_navigation_style == 'outline' or bundle_controls_navigation_style == 'icon_only'
    assign bundle_controls_navigation_style = 'secondary'
  endunless

  assign bundle_controls_navigation_button_variant = bundle_controls_navigation_style
  assign bundle_controls_navigation_button_modifier = blank
  if bundle_controls_navigation_style == 'icon_only'
    assign bundle_controls_navigation_button_variant = 'tertiary'
    assign bundle_controls_navigation_button_modifier = 'swiper-nav-button--icon-only'
  elsif bundle_controls_navigation_style == 'outline'
    assign bundle_controls_navigation_button_variant = 'secondary'
    assign bundle_controls_navigation_button_modifier = 'swiper-nav-button--outline'
  endif

  assign bundle_controls_navigation_icon = block.settings.navigation_icon | default: 'chevron'
  unless bundle_controls_navigation_icon == 'chevron' or bundle_controls_navigation_icon == 'arrow' or bundle_controls_navigation_icon == 'long_arrow'
    assign bundle_controls_navigation_icon = 'chevron'
  endunless

  assign bundle_controls_navigation_behavior = 'always'
  if bundle_controls_navigation_position != 'top'
    assign bundle_controls_navigation_behavior = block.settings.navigation_behavior | default: 'show_on_hover'
    unless bundle_controls_navigation_behavior == 'show_on_hover' or bundle_controls_navigation_behavior == 'always'
      assign bundle_controls_navigation_behavior = 'show_on_hover'
    endunless
  endif

  assign bundle_controls_show_navigation = true
  if block.settings.show_navigation_on_desktop == false or block.settings.show_navigation_on_desktop == 'false'
    assign bundle_controls_show_navigation = false
  endif

  assign bundle_controls_pagination_type = block.settings.pagination_type | default: 'progress_bar'
  unless bundle_controls_pagination_type == 'progress_bar' or bundle_controls_pagination_type == 'bullets'
    assign bundle_controls_pagination_type = 'progress_bar'
  endunless

  assign bundle_controls_pagination_size = 'var(--swiper-pagination-progressbar-size, 4px)'
  if bundle_controls_pagination_type == 'bullets'
    assign bundle_controls_pagination_size = 'var(--swiper-pagination-bullet-size, 0.5rem)'
  endif

  assign bundle_controls_pagination_limit_width = false
  if bundle_controls_pagination_type == 'progress_bar' and block.settings.pagination_limit_width
    assign bundle_controls_pagination_limit_width = true
  endif

  assign bundle_controls_pagination_top_padding_desktop = block.settings.pagination_top_padding_desktop | default: block.settings.pagination_top_padding | default: 50 | plus: 0
  if bundle_controls_pagination_top_padding_desktop < 0 or bundle_controls_pagination_top_padding_desktop > 100
    assign bundle_controls_pagination_top_padding_desktop = 50
  endif

  assign bundle_controls_pagination_top_padding_mobile = block.settings.pagination_top_padding_mobile | default: 24 | plus: 0
  if bundle_controls_pagination_top_padding_mobile < 0 or bundle_controls_pagination_top_padding_mobile > 100
    assign bundle_controls_pagination_top_padding_mobile = 24
  endif

  assign bundle_controls_pagination_max_width = block.settings.pagination_max_width | default: 260 | plus: 0
  if bundle_controls_pagination_max_width < 100 or bundle_controls_pagination_max_width > 600
    assign bundle_controls_pagination_max_width = 260
  endif

  assign bundle_controls_show_pagination = false
  if bundle_layout == 'carousel'
    assign bundle_controls_show_pagination = true
    if block.settings.show_pagination_on_desktop == false or block.settings.show_pagination_on_desktop == 'false'
      assign bundle_controls_show_pagination = false
    endif
  endif

  assign bundle_controls_autoplay_enabled = false
  if bundle_has_carousel and block.settings.autoplay
    assign bundle_controls_autoplay_enabled = true
  endif

  assign bundle_controls_autoplay_pause_on_hover = true
  if block.settings.autoplay_pause_on_hover == false or block.settings.autoplay_pause_on_hover == 'false'
    assign bundle_controls_autoplay_pause_on_hover = false
  endif

  assign bundle_controls_autoplay_speed = block.settings.autoplay_speed | default: 4 | plus: 0
  if bundle_controls_autoplay_speed < 1 or bundle_controls_autoplay_speed > 10
    assign bundle_controls_autoplay_speed = 4
  endif
  assign bundle_controls_autoplay_delay = bundle_controls_autoplay_speed | times: 1000


  assign bundle_controls_pagination_class = 'swiper-pagination--below product-list__pagination product-list__pagination--' | append: bundle_controls_pagination_type
%}

{% capture bundle_placeholder_middle %}
  <div class="bundle-card__options bundle-card__options--empty" aria-hidden="true"></div>
{% endcapture %}

{% capture bundle_grid_items %}
  {% if bundle_products != blank %}
    {% for bundle_product in bundle_products limit: bundle_max_products %}
      {% if bundle_products_are_placeholders %}
        <div class="{% if bundle_has_carousel %}swiper-slide {% endif %}product-collection-grid__item product-card-layout__item bundle-product-item bundle-product-item--placeholder">
          {% render 'product-card',
            product: blank,
            placeholder: true,
            class: 'bundle-product-card',
            hide_swatches: true,
            middle_content: bundle_placeholder_middle,
            footer_content: blank
          %}
        </div>
      {% else %}
        {% liquid
          assign bundle_current_variant = bundle_product.selected_or_first_available_variant
          assign bundle_variant_picker_id = block.id | append: '-' | append: bundle_product.id
          assign bundle_product_image = blank
          assign bundle_product_image_large = blank
          assign bundle_product_image_ratio = 1
          if bundle_product.featured_image != blank
            assign bundle_product_image = bundle_product.featured_image | image_url: width: 160
            assign bundle_product_image_large = bundle_product.featured_image | image_url: width: 800
            assign bundle_product_image_ratio = bundle_product.featured_image.aspect_ratio | default: 1
          endif
          assign bundle_product_available = false
          if bundle_current_variant != blank and bundle_current_variant.available
            assign bundle_product_available = true
          endif
          assign bundle_variant_select_label = 'bundle_builder.select_variant_for' | t: product: bundle_product.title
          assign bundle_sold_out_label = 'products.sold_out' | t
          assign bundle_unavailable_variant_label = 'products.variant_selection_unavailable' | t
        %}
        <div
          class="{% if bundle_has_carousel %}swiper-slide {% endif %}product-collection-grid__item product-card-layout__item bundle-product-item"
          data-bundle-product
          data-product-id="{{ bundle_product.id }}"
          data-product-title="{{ bundle_product.title | escape }}"
          data-product-secondary-image-enabled="{{ settings.product_card_secondary }}"
          data-product-image="{{ bundle_product_image | escape }}"
          data-product-image-ratio="{{ bundle_product_image_ratio }}"
          data-product-image-default="{{ bundle_product_image | escape }}"
          data-product-image-default-large="{{ bundle_product_image_large | escape }}"
          data-product-image-default-ratio="{{ bundle_product_image_ratio }}"
          data-product-image-default-width="{{ bundle_product.featured_image.width }}"
          data-product-image-default-height="{{ bundle_product.featured_image.height }}"
          data-current-variant-id="{{ bundle_current_variant.id }}"
          data-current-variant-available="{{ bundle_product_available }}"
        >
          <script type="application/json" data-bundle-variant-images>
            [
              {% for bundle_variant in bundle_product.variants %}
                {% assign bundle_variant_image = bundle_variant.featured_image | default: bundle_variant.featured_media.preview_image %}
                {% assign bundle_variant_primary_image = bundle_variant_image | default: bundle_product.featured_image %}
                {% assign bundle_variant_secondary_image = blank %}
                {% if bundle_variant_primary_image != blank %}
                  {% for bundle_candidate_image in bundle_product.images %}
                    {% if bundle_candidate_image.id != bundle_variant_primary_image.id and bundle_candidate_image.variants != blank %}
                      {% for bundle_image_variant in bundle_candidate_image.variants %}
                        {% if bundle_image_variant.id == bundle_variant.id %}
                          {% assign bundle_variant_secondary_image = bundle_candidate_image %}
                          {% break %}
                        {% endif %}
                      {% endfor %}
                      {% if bundle_variant_secondary_image != blank %}{% break %}{% endif %}
                    {% endif %}
                  {% endfor %}
                  {% if bundle_variant_secondary_image == blank %}
                    {% for bundle_candidate_image in bundle_product.images %}
                      {% if bundle_candidate_image.id != bundle_variant_primary_image.id and bundle_candidate_image.variants == blank %}
                        {% assign bundle_variant_secondary_image = bundle_candidate_image %}
                        {% break %}
                      {% endif %}
                    {% endfor %}
                  {% endif %}
                {% endif %}
                {
                  "id": {{ bundle_variant.id | json }},
                  "src": {% if bundle_variant_image != blank %}{{ bundle_variant_image | image_url: width: 800 | json }}{% else %}null{% endif %},
                  "thumb_src": {% if bundle_variant_image != blank %}{{ bundle_variant_image | image_url: width: 160 | json }}{% else %}null{% endif %},
                  "alt": {{ bundle_variant_image.alt | default: bundle_product.title | json }},
                  "width": {{ bundle_variant_image.width | json }},
                  "height": {{ bundle_variant_image.height | json }},
                  "aspect_ratio": {{ bundle_variant_image.aspect_ratio | json }},
                  "secondary_src": {% if bundle_variant_secondary_image != blank %}{{ bundle_variant_secondary_image | image_url: width: 800 | json }}{% else %}null{% endif %},
                  "secondary_alt": {{ bundle_variant_secondary_image.alt | default: bundle_product.title | json }},
                  "secondary_width": {{ bundle_variant_secondary_image.width | json }},
                  "secondary_height": {{ bundle_variant_secondary_image.height | json }}
                }{% unless forloop.last %},{% endunless %}
              {% endfor %}
            ]
          </script>
          {% capture bundle_product_dropdown_picker %}
            <label class="visually-hidden" for="bundle-variant-select-placeholder">{{ bundle_variant_select_label | escape }}</label>
            <div class="form__control-wrap--select">
              <select
                id="bundle-variant-select-placeholder"
                class="bundle-card__options-select variant-picker__control variant-picker__control--select form__control form__control--select"
                data-bundle-variant-select
                data-option-names="{{ bundle_product.options | json | escape }}"
                data-sold-out-label="{{ bundle_sold_out_label | escape }}"
                data-unavailable-label="{{ bundle_unavailable_variant_label | escape }}"
              >
                <option value="" disabled>{{ bundle_unavailable_variant_label | escape }}</option>
                {% for bundle_option_variant in bundle_product.variants %}
                  {% capture bundle_option_label %}
                    {% for bundle_variant_option in bundle_option_variant.options_with_values %}{% unless forloop.first %} | {% endunless %}{% assign bundle_variant_option_value = bundle_variant_option.value.name | default: bundle_variant_option.value %}{{ bundle_variant_option.name | escape }}: {{ bundle_variant_option_value | escape }}{% endfor %}
                  {% endcapture %}
                  <option
                    value="{{ bundle_option_variant.id }}"
                    data-variant-available="{{ bundle_option_variant.available }}"
                    {% if bundle_option_variant.id == bundle_current_variant.id %}selected{% endif %}
                  >
                    {{ bundle_option_label | strip }}{% unless bundle_option_variant.available %} — {{ bundle_sold_out_label | escape }}{% endunless %}
                  </option>
                {% endfor %}
              </select>
              <span class="bundle-card__select-icon" aria-hidden="true">{% render 'icon', icon: 'chevron-down', bare: true %}</span>
            </div>
          {% endcapture %}
          {% capture bundle_product_middle %}
            <div class="bundle-card__options{% if bundle_product.has_only_default_variant %} bundle-card__options--empty{% endif %}">
              <script type="application/json" data-bundle-product-variants>{{ bundle_product.variants | json }}</script>
              {% unless bundle_product.has_only_default_variant %}
                <div class="bundle-card__control bundle-card__control--mobile">
                  {% if bundle_variant_picker_type_mobile == 'dropdown' %}
                    {% liquid
                      assign bundle_variant_select_id_mobile = bundle_variant_picker_id | append: '-mobile-select'
                      assign bundle_product_dropdown_picker_mobile = bundle_product_dropdown_picker | replace: 'bundle-variant-select-placeholder', bundle_variant_select_id_mobile
                    %}
                    {{ bundle_product_dropdown_picker_mobile }}
                  {% else %}
                    {% assign bundle_variant_picker_mobile_id = bundle_variant_picker_id | append: '-mobile' %}
                    {% render 'variant-picker',
                      product: bundle_product,
                      current_variant: bundle_current_variant,
                      section_id: section.id,
                      block_id: bundle_variant_picker_mobile_id,
                      type_override: 'button',
                      sync_external_variants: true,
                      update_url_on_change: false,
                      ignore_url_variant: true,
                      swatch_style_override: bundle_product_swatch_type,
                      swatch_selected_style_override: bundle_product_swatch_selected_style,
                      swatch_width_override: bundle_product_swatch_width_desktop,
                      swatch_width_mobile_override: bundle_product_swatch_width_mobile,
                      swatch_height_ratio_override: bundle_product_swatch_height_ratio
                    %}
                  {% endif %}
                </div>
                <div class="bundle-card__control bundle-card__control--desktop">
                  {% if bundle_variant_picker_type == 'dropdown' %}
                    {% liquid
                      assign bundle_variant_select_id_desktop = bundle_variant_picker_id | append: '-desktop-select'
                      assign bundle_product_dropdown_picker_desktop = bundle_product_dropdown_picker | replace: 'bundle-variant-select-placeholder', bundle_variant_select_id_desktop
                    %}
                    {{ bundle_product_dropdown_picker_desktop }}
                  {% else %}
                    {% assign bundle_variant_picker_desktop_id = bundle_variant_picker_id | append: '-desktop' %}
                    {% render 'variant-picker',
                      product: bundle_product,
                      current_variant: bundle_current_variant,
                      section_id: section.id,
                      block_id: bundle_variant_picker_desktop_id,
                      type_override: 'button',
                      sync_external_variants: true,
                      update_url_on_change: false,
                      ignore_url_variant: true,
                      swatch_style_override: bundle_product_swatch_type,
                      swatch_selected_style_override: bundle_product_swatch_selected_style,
                      swatch_width_override: bundle_product_swatch_width_desktop,
                      swatch_width_mobile_override: bundle_product_swatch_width_mobile,
                      swatch_height_ratio_override: bundle_product_swatch_height_ratio
                    %}
                  {% endif %}
                </div>
              {% endunless %}
            </div>
          {% endcapture %}

          {% assign bundle_product_footer = '' %}
          {% render 'product-card',
            product: bundle_product,
            class: 'bundle-product-card',
            hide_swatches: true,
            middle_content: bundle_product_middle,
            footer_content: bundle_product_footer
          %}
        </div>
      {% endif %}
    {% endfor %}
  {% endif %}
{% endcapture %}
{% assign bundle_grid_items = bundle_grid_items | strip %}

{% capture bundle_source_product_ids -%}
  {%- for selected_product in block.settings.products -%}
    {{- selected_product.id -}}
    {%- unless forloop.last -%},{%- endunless -%}
  {%- endfor -%}
{%- endcapture %}

{% capture bundle_controls_pagination_style %}
  {% if bundle_controls_show_pagination %}
    --swiper-pagination-spacing: {{ bundle_controls_pagination_top_padding_desktop }}px;
    --swiper-pagination-spacing-mobile: {{ bundle_controls_pagination_top_padding_mobile }}px;
    {% if bundle_controls_pagination_limit_width %}--swiper-pagination-width: min(100%, {{ bundle_controls_pagination_max_width }}px);{% endif %}
  {% endif %}
{% endcapture %}
{% assign bundle_controls_pagination_style = bundle_controls_pagination_style | strip %}

{% capture bundle_controls_navigation_center_style %}
  {% if bundle_layout == 'carousel' and bundle_controls_show_pagination and bundle_controls_navigation_position != 'top' %}--swiper-navigation-center-offset: calc(({{ bundle_controls_pagination_top_padding_desktop }}px + {{ bundle_controls_pagination_size }}) / 2);{% endif %}
{% endcapture %}
{% assign bundle_controls_navigation_center_style = bundle_controls_navigation_center_style | strip %}

{% capture bundle_controls_navigation_markup %}
  {% if bundle_has_carousel %}
    {% if bundle_controls_show_navigation %}
    <div
      class="swiper-carousel__navigation--centered swiper-carousel__navigation--{{ bundle_controls_navigation_behavior }} product-list__navigation product-list__navigation--{{ bundle_controls_navigation_position }}{% if bundle_controls_navigation_position == 'top' %} section-list-layout__navigation{% endif %} product-list__navigation--{{ bundle_controls_navigation_behavior }}"
      data-product-list-navigation
      {% if bundle_controls_navigation_center_style != blank %}style="{{ bundle_controls_navigation_center_style }}"{% endif %}
    >
      <button
        class="btn btn-{{ bundle_controls_navigation_button_variant }} btn--{{ bundle_controls_navigation_button_variant }} btn--icon{% if bundle_controls_navigation_button_modifier != blank %} {{ bundle_controls_navigation_button_modifier }}{% endif %} swiper-nav-button swiper-nav-button--prev product-list__carousel-button"
        type="button"
        data-product-list-previous
        aria-label="{{ 'collection_tabs.previous' | t | escape }}"
      >
        {% render 'carousel-navigation-icon', icon: bundle_controls_navigation_icon, direction: 'previous' %}
      </button>
      <button
        class="btn btn-{{ bundle_controls_navigation_button_variant }} btn--{{ bundle_controls_navigation_button_variant }} btn--icon{% if bundle_controls_navigation_button_modifier != blank %} {{ bundle_controls_navigation_button_modifier }}{% endif %} swiper-nav-button swiper-nav-button--next product-list__carousel-button"
        type="button"
        data-product-list-next
        aria-label="{{ 'collection_tabs.next' | t | escape }}"
      >
        {% render 'carousel-navigation-icon', icon: bundle_controls_navigation_icon, direction: 'next' %}
      </button>
    </div>
  {% endif %}
{% endif %}
{% endcapture %}
{% assign bundle_controls_navigation_markup = bundle_controls_navigation_markup | strip %}


{% capture bundle_controls_attributes %}
  data-bundle-carousel="true"
  data-swiper-loop="{{ block.settings.loop }}"
{% endcapture %}
{% if bundle_has_carousel %}<script data-theme-module="{{ 'product-collection-carousel.js' | asset_url }}"></script>{% endif %}
{% capture bundle_list_padding %}
  --bundle-list-padding-top: {{ block.settings.padding_top | default: 0 }}px;
  --bundle-list-padding-bottom: {{ block.settings.padding_bottom | default: 0 }}px;
  --bundle-list-padding-left: {{ block.settings.padding_left | default: 0 }}px;
  --bundle-list-padding-right: {{ block.settings.padding_right | default: 0 }}px;
  {% if block.settings.customize_mobile_padding %}
    --bundle-list-padding-top-mobile: {{ block.settings.padding_top_mobile | default: 0 }}px;
    --bundle-list-padding-bottom-mobile: {{ block.settings.padding_bottom_mobile | default: 0 }}px;
    --bundle-list-padding-left-mobile: {{ block.settings.padding_left_mobile | default: 0 }}px;
    --bundle-list-padding-right-mobile: {{ block.settings.padding_right_mobile | default: 0 }}px;
  {% endif %}
{% endcapture %}
<div
  class="bundle-product-list"
  style="{{ bundle_list_padding | strip }}"
  data-desktop-pagination="{{ block.settings.show_pagination_on_desktop }}"
  data-product-list
  data-desktop-navigation="{{ block.settings.show_navigation_on_desktop }}"
  data-layout="{{ bundle_layout }}"
  data-layout-mobile="{{ bundle_layout_mobile }}"
  data-bundle-source-collection="{{ bundle_source_collection.id }}"
  data-bundle-source-products="{{ bundle_source_product_ids }}"
  {{ block.shopify_attributes }}
>
  {% if bundle_controls_navigation_position == 'top' %}{{ bundle_controls_navigation_markup }}{% endif %}
  <div class="product-list__carousel swiper-carousel__container">
  {% if bundle_grid_items != blank %}
    {% render 'product-collection-grid',
      items_content: bundle_grid_items,
      max_products: bundle_max_products,
      layout_type: bundle_layout,
      layout_type_mobile: bundle_layout_mobile,
      next_slide_preview: block.settings.show_next_slide_preview_on_desktop,
      next_slide_preview_on_mobile: block.settings.show_next_slide_preview_on_mobile,
      columns_desktop: bundle_columns_desktop,
      columns_mobile: bundle_columns_mobile,
      gap_horizontal: block.settings.gap_horizontal,
      gap_vertical: block.settings.gap_horizontal,
      gap_horizontal_mobile: block.settings.gap_horizontal_mobile,
      gap_vertical_mobile: block.settings.gap_horizontal_mobile,
      grid_class: 'bundle-product-grid',
      aria_label: bundle_products_aria_label,
      previous_selector: '[data-product-list-previous]',
      next_selector: '[data-product-list-next]',
      show_pagination: bundle_controls_show_pagination,
      pagination_type: bundle_controls_pagination_type,
      pagination_class: bundle_controls_pagination_class,
      pagination_style: bundle_controls_pagination_style,
      autoplay: bundle_controls_autoplay_enabled,
      autoplay_pause_on_hover: bundle_controls_autoplay_pause_on_hover,
      autoplay_delay: bundle_controls_autoplay_delay,
      items_data_attributes: bundle_controls_attributes
    %}
  {% endif %}
  {% if bundle_controls_navigation_position != 'top' %}{{ bundle_controls_navigation_markup }}{% endif %}
  </div>
</div>

{% stylesheet %}
  .product-list__carousel {
    position: relative;
    width: 100%;
    min-width: 0;
  }

  .product-list__navigation {
    position: absolute;
    z-index: 1;
    right: 0;
    left: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-inline: 0.5rem;
    pointer-events: none;
    transform: translateY(-50%);
  }

  .product-list__navigation--outside {
    padding-inline: 0;
  }

  .product-list__navigation.product-list__navigation--top {
    position: relative;
    inset: auto;
    width: max-content;
    max-width: 100%;
    gap: 0.5rem;
    padding-inline: 0;
    transform: none;
  }

  .product-list__navigation--outside .swiper-nav-button--prev {
    margin-inline-start: calc(-1 * var(--swiper-nav-size) / 2);
  }

  .product-list__navigation--outside .swiper-nav-button--next {
    margin-inline-end: calc(-1 * var(--swiper-nav-size) / 2);
  }

  .product-list__carousel-button {
    pointer-events: auto;
  }


  @media (min-width: 768px) { .bundle-product-list[data-layout="grid"] :is(.product-list__navigation, .product-list__pagination) { display: none; } .bundle-product-list[data-desktop-navigation="false"] .product-list__navigation { display: none; } .bundle-product-list[data-desktop-pagination="false"] .product-list__pagination { display: none; } }
  @media (max-width: 767.98px) {
    .bundle-product-list[data-layout-mobile="grid"] :is(.product-list__navigation, .product-list__pagination) { display: none; }
    .bundle-product-list[data-desktop-pagination="false"] .product-list__pagination { display: none; }
    .bundle-product-list .product-list__navigation { display: none; }
  }
  .bundle-product-list {
    padding: var(--bundle-list-padding-top, 0px) var(--bundle-list-padding-right, 0px) var(--bundle-list-padding-bottom, 0px) var(--bundle-list-padding-left, 0px);
    min-width: 0;
  }

  .bundle-product-grid.product-collection-grid--responsive-layout:not(.swiper-initialized) > .swiper-wrapper {
    display: grid;
    grid-template-columns: repeat(var(--product-collection-grid-columns-desktop, 3), minmax(0, 1fr));
    gap: var(--product-collection-grid-gap-vertical, 16px) var(--product-collection-grid-gap-horizontal, 16px);
  }
  .bundle-product-grid.product-collection-grid--responsive-layout:not(.swiper-initialized) > .swiper-wrapper > .swiper-slide { width: auto; margin-inline-end: 0; }
  @media (max-width: 767.98px) {
    .bundle-product-grid.product-collection-grid--responsive-layout:not(.swiper-initialized) > .swiper-wrapper {
      grid-template-columns: repeat(var(--product-collection-grid-columns-mobile, 2), minmax(0, 1fr));
      gap: var(--product-collection-grid-gap-vertical-mobile, 12px) var(--product-collection-grid-gap-horizontal-mobile, 12px);
    }
  }
  .bundle-product-grid {
    align-items: stretch;
  }

  .bundle-product-item {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .bundle-product-card {
    --product-card-alignment: left;
    --product-card-content-alignment: flex-start;
    --product-card-info-gap: 4px;
    --product-card-info-gap-mobile: 4px;
    --product-card-content-gap: 8px;
    --product-card-content-gap-mobile: 8px;
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    gap: 16px;
    min-width: 0;
  }

  .bundle-product-list .bundle-product-card .product-card__media {
    aspect-ratio: 4 / 5;
    border-radius: 16px;
  }

  .bundle-product-list .bundle-product-card .product-card__image-link,
  .bundle-product-list .bundle-product-card .product-card__image,
  .bundle-product-list .bundle-product-card .product-card__image > img {
    height: 100%;
  }

  .bundle-product-list .bundle-product-card .product-card__content {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-height: 0;
    padding: 0;
    text-align: left;
  }

  .bundle-product-list .bundle-product-card .product-card__details {
    flex: 0 0 auto;
    gap: 4px;
  }

  .bundle-product-list .bundle-product-card :is(.product-card__title, .product-card__title-link, .product-card__price, .price__value, .price__unit) {
    font-size: 16px;
    font-weight: 500;
    line-height: 24px;
    text-transform: capitalize;
    text-align: left;
  }

  .bundle-product-list .bundle-product-card :is(.product-card__title, .product-card__price) {
    margin: 0;
  }

  .bundle-product-item .product-card__quick-add {
    display: none !important;
  }

  .bundle-card__options {
    min-width: 0;
    width: 100%;
  }

  .bundle-card__options--empty,
  .bundle-card__options:not(:has(.variant-picker__option)):not(:has(.form__control)) {
    display: none;
  }

  .bundle-card__options .variant-picker {
    margin: 0;
    padding-top: 0;
    border-top: 0;
  }

  .bundle-card__options .variant-picker__option > .variant-picker__label {
    color: var(--heading-color);
  }

  .bundle-card__options .variant-picker__controls {
    justify-content: var(--product-card-content-alignment, flex-start);
  }

  .bundle-card__options .variant-picker__button:not(.swatch__label) {
    min-width: 4.6rem;
    justify-content: center;
  }

  .bundle-card__options .variant-picker__control--radio:checked + .variant-picker__button:not(.swatch__label) {
    border-color: var(--heading-color);
    background-color: var(--heading-color);
    color: var(--background-color);
  }

  .bundle-card__options .variant-picker__option--swatches {
    --swatch-width: var(--product-swatch-width, var(--product-card-swatch-width, 30px));
  }

  .bundle-card__options .variant-picker__option--swatches .swatch {
    position: relative;
    border: 1px solid color-mix(in srgb, var(--body-color) 15%, transparent);
  }

  .bundle-card__options .variant-picker__option--swatches .swatch::before {
    position: absolute;
    inset: 0;
    border: 3px solid transparent;
    border-radius: inherit;
    content: '';
    pointer-events: none;
  }

  .bundle-card__options .variant-picker__option--swatches .swatch-control--border:has(> .swatch__input:checked) .swatch {
    border-color: var(--heading-color);
  }

  .bundle-card__options .variant-picker__option--swatches .swatch-control--border:has(> .swatch__input:checked) .swatch::before {
    border-color: var(--background-color);
  }

  .bundle-card__options .variant-picker__option--swatches .swatch-control--border:has(> .swatch__input:checked) .swatch {
    outline: 0;
    outline-offset: 0;
  }

  .bundle-card__options .variant-picker__option--swatches .variant-picker__controls.swatches--selected-underline .variant-picker__choice {
    position: relative;
    padding-block-end: 5px;
  }

  .bundle-card__options .variant-picker__option--swatches .variant-picker__controls.swatches--selected-underline .variant-picker__choice::after {
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    height: 1px;
    background-color: transparent;
    content: '';
    pointer-events: none;
    transition: background-color var(--motion-duration-slow) var(--motion-ease-standard);
  }

  .bundle-card__options .variant-picker__option--swatches .variant-picker__controls.swatches--selected-underline .variant-picker__choice:has(.swatch__input:checked)::after {
    background-color: var(--heading-color);
  }

  .bundle-card__options .variant-picker__option--swatches .variant-picker__controls.swatches--selected-underline .swatch-control--underline:has(> .swatch__input:checked) {
    padding-block-end: 0;
    border-block-end: 0;
  }

  .bundle-card__options .variant-picker__option--swatches .variant-picker__controls.swatches--selected-underline .swatch-control--underline:has(.swatch--white) {
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--body-color) 15%, transparent);
  }

  .bundle-card__options .variant-picker--button {
    --variant-border-width: var(--input-border-width-outline, 1px);
  }

  .bundle-card__options .variant-picker__control--select {
    --variant-height: 21px;
    --variant-height-mobile: 21px;
    --variant-border-width: 0px;
    --variant-radius: 0px;
    height: 21px;
    min-height: 21px;
    field-sizing: content;
    width: auto;
    max-width: 100%;
    padding: 0 21px 0 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: #666;
    font-size: 14px;
    font-weight: 400;
    line-height: 21px;
    text-align: left;
  }

  .bundle-card__options .form__control-wrap--select::after {
    display: none;
  }

  .bundle-card__select-icon {
    position: absolute;
    inset-inline-end: 0;
    top: 50%;
    width: 13px;
    height: 13px;
    color: #666;
    pointer-events: none;
    transform: translateY(-50%);
  }

  .bundle-card__select-icon > svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .bundle-card__control--mobile {
    display: none;
  }

  .bundle-card__control {
    width: 100%;
    min-width: 0;
  }

  .bundle-card__control .form__control-wrap--select {
    width: fit-content;
    max-width: 100%;
    min-width: 0;
  }

  .bundle-product-toggle {
    width: 100%;
  }

  .bundle-card__add {
    margin-block-start: auto;
  }

  .bundle-product-toggle.btn--outline {
    background: transparent;
    color: var(--button-secondary-text);
    border-color: var(--button-secondary-border);
  }

  .bundle-product-toggle.btn:disabled {
    opacity: 0.55;
    cursor: not-allowed;
    pointer-events: auto;
  }

  .bundle-product-item--placeholder .bundle-card__add[disabled] {
    opacity: 0.5;
    cursor: not-allowed;
  }

  @media (max-width: 767.98px) {
    .bundle-card__options .variant-picker__option--swatches {
      --swatch-width: var(--product-swatch-width-mobile, var(--product-swatch-width, var(--product-card-swatch-width-mobile, 30px)));
    }

    .bundle-card__control--desktop {
      display: none;
    }

    .bundle-card__control--mobile {
      display: block;
    }
  }
  @media (max-width: 767.98px) {
    .bundle-product-list {
      padding: var(--bundle-list-padding-top-mobile, var(--bundle-list-padding-top, 0px)) var(--bundle-list-padding-right-mobile, var(--bundle-list-padding-right, 0px)) var(--bundle-list-padding-bottom-mobile, var(--bundle-list-padding-bottom, 0px)) var(--bundle-list-padding-left-mobile, var(--bundle-list-padding-left, 0px));
    }
  }
{% endstylesheet %}

{% schema %}
{
