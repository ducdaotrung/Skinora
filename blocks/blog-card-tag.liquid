{%- capture theme_size_font_size -%}{%- render 'typography-size-token', size: block.settings.font_size, role: 'body', fallback: 'sm' -%}{%- endcapture -%}
{% doc %}
  Renders the publication date and author inside Blog Card.

  The parent Blog Card supplies the current article through `closest.article`.
{% enddoc %}

{% liquid
  assign blog_card_tag_article = closest.article | default: article
  assign blog_card_tag_date = blog_card_tag_article.published_at
  assign blog_card_tag_author = blog_card_tag_article.author
  if blog_card_tag_article == blank
    assign blog_card_tag_date = '2025-06-11'
    assign blog_card_tag_author = 'Author'
  endif

  assign blog_card_tag_font = block.settings.font | default: 'accent'
  unless blog_card_tag_font == 'body' or blog_card_tag_font == 'heading' or blog_card_tag_font == 'accent'
    assign blog_card_tag_font = 'accent'
  endunless

  assign blog_card_tag_size = theme_size_font_size | default: 'sm'
  unless blog_card_tag_size == 'display' or blog_card_tag_size == 'xs' or blog_card_tag_size == 'sm' or blog_card_tag_size == 'md' or blog_card_tag_size == 'lg' or blog_card_tag_size == 'xl' or blog_card_tag_size == 'xxl'
    assign blog_card_tag_size = 'sm'
  endunless

  assign blog_card_tag_letter_spacing = block.settings.letter_spacing | default: 'normal'
  unless blog_card_tag_letter_spacing == 'tight' or blog_card_tag_letter_spacing == 'normal' or blog_card_tag_letter_spacing == 'relaxed'
    assign blog_card_tag_letter_spacing = 'normal'
  endunless

  assign blog_card_tag_presentation = block.settings.style | default: 'text'
  unless blog_card_tag_presentation == 'text' or blog_card_tag_presentation == 'outline' or blog_card_tag_presentation == 'background'
    assign blog_card_tag_presentation = 'text'
  endunless

  assign blog_card_tag_color = block.settings.text_color
  if blog_card_tag_color == blank
    case block.settings.color
      when 'heading'
        assign blog_card_tag_color = 'var(--heading-color)'
      when 'text'
        assign blog_card_tag_color = 'var(--body-color)'
    endcase
  endif
  assign blog_card_tag_color = blog_card_tag_color | default: 'var(--body-color)'

  assign blog_card_tag_padding_top = block.settings.padding_top | default: 8 | plus: 0
  assign blog_card_tag_padding_bottom = block.settings.padding_bottom | default: 0 | plus: 0
  assign blog_card_tag_padding_top_mobile = block.settings.padding_top_mobile | default: blog_card_tag_padding_top | plus: 0
  assign blog_card_tag_padding_bottom_mobile = block.settings.padding_bottom_mobile | default: blog_card_tag_padding_bottom | plus: 0

  if blog_card_tag_padding_top < 0 or blog_card_tag_padding_top > 100
    assign blog_card_tag_padding_top = 8
  endif
  if blog_card_tag_padding_bottom < 0 or blog_card_tag_padding_bottom > 100
    assign blog_card_tag_padding_bottom = 0
  endif
  if blog_card_tag_padding_top_mobile < 0 or blog_card_tag_padding_top_mobile > 100
    assign blog_card_tag_padding_top_mobile = blog_card_tag_padding_top
  endif
  if blog_card_tag_padding_bottom_mobile < 0 or blog_card_tag_padding_bottom_mobile > 100
    assign blog_card_tag_padding_bottom_mobile = blog_card_tag_padding_bottom
  endif

  assign blog_card_tag_class = 'blog-card-tag font-' | append: blog_card_tag_font
  assign blog_card_tag_class = blog_card_tag_class | append: ' body-' | append: blog_card_tag_size
  assign blog_card_tag_class = blog_card_tag_class | append: ' tracking-' | append: blog_card_tag_letter_spacing
  assign blog_card_tag_class = blog_card_tag_class | append: ' blog-card-tag--style-' | append: blog_card_tag_presentation
%}

{% capture blog_card_tag_style %}
  {% if blog_card_tag_color != blank %}--blog-card-tag-color: {{ blog_card_tag_color | escape }};{% endif %}
  {% if blog_card_tag_padding_top != 8 %}--blog-card-tag-padding-top: {{ blog_card_tag_padding_top }}px;{% endif %}
  {% if blog_card_tag_padding_bottom != 0 %}--blog-card-tag-padding-bottom: {{ blog_card_tag_padding_bottom }}px;{% endif %}
  {% if block.settings.customize_mobile_padding %}
    {% if blog_card_tag_padding_top_mobile != blog_card_tag_padding_top %}--blog-card-tag-padding-top-mobile: {{ blog_card_tag_padding_top_mobile }}px;{% endif %}
    {% if blog_card_tag_padding_bottom_mobile != blog_card_tag_padding_bottom %}--blog-card-tag-padding-bottom-mobile: {{ blog_card_tag_padding_bottom_mobile }}px;{% endif %}
  {% endif %}
{% endcapture %}
{% assign blog_card_tag_style = blog_card_tag_style | strip %}

{% if blog_card_tag_date != blank or blog_card_tag_author != blank %}
  <div
    class="{{ blog_card_tag_class }}"
    {% if blog_card_tag_style != blank %}style="{{ blog_card_tag_style }}"{% endif %}
    {{ block.shopify_attributes }}
  >
    {% if blog_card_tag_date != blank %}
      <time class="blog-card-tag__label" datetime="{{ blog_card_tag_date | date: '%Y-%m-%d' }}">{{ blog_card_tag_date | date: '%B %-d, %Y' }}</time>
    {% endif %}
    {% if blog_card_tag_author != blank %}
      <span class="blog-card-tag__author">
        {% if blog_card_tag_date != blank %}<span class="blog-card-tag__separator" aria-hidden="true"></span>{% endif %}
        <span>{{ blog_card_tag_author | escape }}</span>
      </span>
    {% endif %}
  </div>
{% endif %}

{% stylesheet %}
  .blog-card-tag {
    --blog-card-tag-color: var(--body-color);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: var(--blog-card-align-flex, flex-start);
    gap: 8px;
    width: 100%;
    padding-top: var(--blog-card-tag-padding-top, 8px);
    padding-bottom: var(--blog-card-tag-padding-bottom, 0px);
    color: var(--blog-card-tag-color);
    text-align: inherit;
    overflow-wrap: anywhere;
  }

  .blog-card-tag__label { display: inline-block; text-transform: none; }

  .blog-card-tag__author {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
    text-transform: none;
  }

  .blog-card-tag__separator {
    flex: 0 0 4px;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background-color: #808080;
  }

  .blog-card-tag--style-outline .blog-card-tag__label {
    padding: 4px 12px;
    border: 1px solid var(--border-color);
  }

  .blog-card-tag--style-background .blog-card-tag__label {
    padding: 4px 12px;
    background-color: var(--blog-card-tag-color);
    color: var(--background-color);
  }

  @media (max-width: 767.98px) {
    .blog-card-tag {
      padding-top: var(--blog-card-tag-padding-top-mobile, var(--blog-card-tag-padding-top, 8px));
      padding-bottom: var(--blog-card-tag-padding-bottom-mobile, var(--blog-card-tag-padding-bottom, 0px));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Date and author",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "style",
      "label": "t:labels.style",
      "options": [
        { "value": "text", "label": "Text" },
        { "value": "outline", "label": "Outline" },
        { "value": "background", "label": "Background" }
      ],
      "default": "text"
    },
    {
      "type": "header",
      "content": "t:general.typography"
    },
    {
      "type": "select",
      "id": "font",
      "label": "t:labels.font",
      "options": [
        { "value": "heading", "label": "t:options.product_price_font.heading" },
        { "value": "body", "label": "t:options.product_price_font.body" },
        { "value": "accent", "label": "t:options.product_price_font.accent" }
      ],
      "default": "accent"
    },
    {
      "type": "select",
      "id": "font_size",
      "label": "t:labels.font_size",
      "options": [
        { "value": "display", "label": "t:options.heading_size.display" },
        { "value": "xs", "label": "t:options.product_price_size.xs" },
        { "value": "sm", "label": "t:options.product_price_size.sm" },
        { "value": "md", "label": "t:options.product_price_size.md" },
        { "value": "lg", "label": "t:options.product_price_size.lg" },
        { "value": "xl", "label": "t:options.product_price_size.xl" },
        { "value": "xxl", "label": "t:options.product_price_size.xxl" }
      ],
      "default": "display"
    },
    {
      "type": "select",
      "id": "letter_spacing",
      "label": "t:labels.letter_spacing",
      "options": [
        { "value": "tight", "label": "t:options.letter_spacing.tight" },
        { "value": "normal", "label": "t:options.letter_spacing.normal" },
        { "value": "relaxed", "label": "t:options.letter_spacing.relaxed" }
      ],
      "default": "normal"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "text_color",
      "label": "t:labels.text_color"
    },
    {
      "type": "header",
      "content": "t:general.padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.top_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.bottom_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "customize_mobile_padding",
      "label": "t:labels.customize_mobile_padding",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:labels.mobile_top_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8,
      "visible_if": "{{ block.settings.customize_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:labels.mobile_bottom_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.customize_mobile_padding }}"
    }
  ],
  "presets": [
    {
      "name": "Date and author",
      "category": "Blog",
      "settings": {
        "font": "accent",
        "font_size": "display",
        "letter_spacing": "normal",
        "style": "text",
        "text_color": "",
        "padding_top": 0,
        "padding_bottom": 0,
        "customize_mobile_padding": false,
        "padding_top_mobile": 0,
        "padding_bottom_mobile": 0
      }
    }
  ]
}
{% endschema %}
