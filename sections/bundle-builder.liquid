      "label": "t:labels.mobile_gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 30
    },
    {
      "type": "header",
      "content": "t:general.appearance"
    },
    {
      "type": "select",
      "id": "background_media",
      "label": "t:general.media",
