{% liquid
  assign bundle_builder_width = 'page-width'
  if section.settings.section_width == 'full_width'
    assign bundle_builder_width = 'full-width'
  endif

  assign bundle_builder_scheme = section.settings.color_scheme | default: 'scheme-1'
  if section.settings.color_scheme.id != blank
    assign bundle_builder_scheme = section.settings.color_scheme.id
  endif
  assign bundle_builder_scheme = bundle_builder_scheme | default: 'scheme-1' | handleize

  assign bundle_builder_alignment = section.settings.alignment | default: 'left'
  assign bundle_builder_flex_alignment = 'flex-start'
  case bundle_builder_alignment
    when 'center'
      assign bundle_builder_flex_alignment = 'center'
    when 'right'
      assign bundle_builder_flex_alignment = 'flex-end'
    else
      assign bundle_builder_alignment = 'left'
  endcase

  assign bundle_column_gap = section.settings.column_gap | default: 12 | plus: 0
  assign bundle_column_gap_mobile = bundle_column_gap
  if section.settings.customize_mobile_column_gap
    assign bundle_column_gap_mobile = section.settings.column_gap_mobile | default: 12 | plus: 0
  endif
  assign bundle_builder_gap_desktop = section.settings.gap_desktop | default: 60 | plus: 0
  assign bundle_builder_gap_mobile = section.settings.gap_mobile | default: 30 | plus: 0

  assign bundle_builder_padding_top = section.settings.padding_top | default: 40 | plus: 0
  assign bundle_builder_padding_bottom = section.settings.padding_bottom | default: 40 | plus: 0
  assign bundle_builder_padding_top_mobile = section.settings.padding_top_mobile | default: bundle_builder_padding_top | plus: 0
  assign bundle_builder_padding_bottom_mobile = section.settings.padding_bottom_mobile | default: bundle_builder_padding_bottom | plus: 0
  assign bundle_image_radius = 'var(--media-radius, var(--radius-square))'
  case section.settings.corner_radius
    when 'square'
      assign bundle_image_radius = 'var(--radius-square)'
    when 'rounded'
      assign bundle_image_radius = 'var(--radius-rounded)'
    when 'full'
      assign bundle_image_radius = 'var(--radius-pill)'
    when 'custom'
      assign bundle_image_radius = section.settings.custom_corner_radius | default: 0 | append: 'px'
  endcase
  capture bundle_image_ratio
    render 'image-ratio-value', setting: section.settings.image_ratio, fallback_ratio: 'auto', custom_width: section.settings.image_ratio_custom_width, custom_height: section.settings.image_ratio_custom_height
  endcapture
  assign bundle_image_ratio = bundle_image_ratio | strip
  assign bundle_image_radius_mobile = bundle_image_radius
  assign bundle_image_ratio_mobile = bundle_image_ratio
  if section.settings.customize_mobile_image
    case section.settings.corner_radius_mobile
      when 'inherit'
        assign bundle_image_radius_mobile = 'var(--media-radius, var(--radius-square))'
      when 'square'
        assign bundle_image_radius_mobile = 'var(--radius-square)'
      when 'rounded'
        assign bundle_image_radius_mobile = 'var(--radius-rounded)'
      when 'full'
        assign bundle_image_radius_mobile = 'var(--radius-pill)'
      when 'custom'
        assign bundle_image_radius_mobile = section.settings.custom_corner_radius_mobile | default: 0 | append: 'px'
    endcase
    capture bundle_image_ratio_mobile
      render 'image-ratio-value', setting: section.settings.image_ratio_mobile, fallback_ratio: 'auto', custom_width: section.settings.image_ratio_custom_width_mobile, custom_height: section.settings.image_ratio_custom_height_mobile
    endcapture
    assign bundle_image_ratio_mobile = bundle_image_ratio_mobile | strip
  endif
  assign bundle_builder_image_alt = section.settings.image.alt | default: shop.name
%}

{% capture bundle_builder_style %}
  --bundle-image-radius: {{ bundle_image_radius }};
  --bundle-image-radius-mobile: {{ bundle_image_radius_mobile }};
  --bundle-image-ratio: {{ bundle_image_ratio }};
  --bundle-image-ratio-mobile: {{ bundle_image_ratio_mobile }};
  --flex-align: {{ bundle_builder_flex_alignment }};
  --text-align-default: {{ bundle_builder_alignment }};

  --bundle-builder-gap: {{ bundle_builder_gap_desktop }}px;
  --bundle-builder-gap-mobile: {{ bundle_builder_gap_mobile }}px;
  {% if bundle_builder_padding_top != 40 %}--bundle-builder-padding-top: {{ bundle_builder_padding_top }}px;{% endif %}
  {% if bundle_builder_padding_bottom != 40 %}--bundle-builder-padding-bottom: {{ bundle_builder_padding_bottom }}px;{% endif %}
  {% if section.settings.background_color != blank %}--background-color: {{ section.settings.background_color | escape }};{% endif %}
  {% if section.settings.customize_mobile_padding %}
    {% if bundle_builder_padding_top_mobile != bundle_builder_padding_top %}--bundle-builder-padding-top-mobile: {{ bundle_builder_padding_top_mobile }}px;{% endif %}
    {% if bundle_builder_padding_bottom_mobile != bundle_builder_padding_bottom %}--bundle-builder-padding-bottom-mobile: {{ bundle_builder_padding_bottom_mobile }}px;{% endif %}
  {% endif %}
{% endcapture %}
{% assign bundle_builder_style = bundle_builder_style | strip %}

<div
  class="section-spacing section-color-scope color-scheme {{ bundle_builder_scheme }} bundle-builder"
  {% if bundle_builder_style != blank %}style="{{ bundle_builder_style }}"{% endif %}
>
  {% if section.settings.background_media != 'none' %}
    <div class="bundle-builder__background" aria-hidden="true">
      {% if section.settings.background_media == 'image' and section.settings.background_image != blank %}
        {{ section.settings.background_image | image_url: width: 2400 | image_tag: widths: '750, 1100, 1500, 2000, 2400', sizes: '100vw', alt: '' }}
      {% elsif section.settings.background_media == 'video' and section.settings.background_video != blank %}
        {{ section.settings.background_video | video_tag: autoplay: true, loop: true, muted: true, controls: false }}
      {% endif %}
    </div>
  {% endif %}
  <div
    class="container {{ bundle_builder_width }} bundle-builder__container"
    style="--bundle-column-gap-desktop: {{ bundle_column_gap }}px; --bundle-column-gap-mobile: {{ bundle_column_gap_mobile }}px; column-gap: var(--bundle-column-gap-current, var(--bundle-column-gap-desktop)); row-gap: var(--bundle-column-row-gap, 0px);"
    data-bundle-add-all="true"
    data-bundle-builder
    data-section-id="{{ section.id }}"
    data-bundle-design-mode="{{ request.design_mode }}"
    data-currency="{{ cart.currency.iso_code | default: shop.currency }}"
    data-currency-code-display="{{ settings.price_currency_code_product_cards }}"
    data-money-format="{{ shop.money_format | escape }}"
    data-money-with-currency-format="{{ shop.money_with_currency_format | escape }}"
  >
    <div class="bundle-builder__image{% if section.settings.image == blank %} bundle-builder__image--empty{% endif %}" data-ratio="{{ section.settings.image_ratio | default: 'auto' }}" data-mobile-ratio="{% if section.settings.customize_mobile_image %}{{ section.settings.image_ratio_mobile | default: 'auto' }}{% else %}{{ section.settings.image_ratio | default: 'auto' }}{% endif %}">
      {% if section.settings.image != blank %}
        {{ section.settings.image | image_url: width: 1600 | image_tag: widths: '480, 720, 960, 1200, 1600', sizes: '(min-width: 768px) 32vw, 100vw', alt: bundle_builder_image_alt, loading: 'lazy' }}
      {% endif %}
    </div>
    <div class="bundle-builder__content">
      <div class="bundle-builder__header">
        {% content_for 'blocks' %}
      </div>
      {% content_for 'block', type: '_bundle-product-list', id: 'products' %}      {% content_for 'block', type: '_bundle-cta', id: 'cta' %}
    </div>
    <noscript><p class="body-text body-md">{{ 'bundle_builder.javascript_required' | t }}</p></noscript>
  </div>
</div>

<script type="module" src="{{ 'variant-picker.js' | asset_url }}"></script>
{{ 'component-bouncing-dots.css' | asset_url | stylesheet_tag }}
<script type="module" src="{{ 'bundle-builder.js' | asset_url }}"></script>

{% stylesheet %}
  .bundle-builder { position: relative; isolation: isolate; width: 100%; padding-block: var(--bundle-builder-padding-top, 40px) var(--bundle-builder-padding-bottom, 40px); background: var(--background-color); }
  .bundle-builder__background { position: absolute; z-index: -1; inset: 0; }
  .bundle-builder__background :is(img, video) { width: 100%; height: 100%; object-fit: cover; }
  .bundle-builder__container { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2.11fr); grid-template-areas: "image content";  align-items: stretch; }
  .bundle-builder__content { grid-area: content; display: flex; flex-direction: column; min-width: 0; gap: var(--bundle-builder-gap, 28px); }
  .bundle-builder__image { grid-area: image; min-width: 0; overflow: hidden; border-radius: var(--bundle-image-radius); aspect-ratio: var(--bundle-image-ratio, auto); }
  .bundle-builder__image:has(img) { position: relative; }
  .bundle-builder__image img { display: block; width: 100%; height: 100%; object-fit: cover; }
  @media (min-width: 768px) {
    .bundle-builder__image:not([data-ratio="auto"]) { align-self: start; }
    .bundle-builder__image:not([data-ratio="auto"]) img { position: absolute; inset: 0; }
  }
  .bundle-builder__image--empty { display: none; }
  .bundle-builder__container:has(.bundle-builder__image--empty) { grid-template-columns: minmax(0, 1fr); grid-template-areas: "content"; }
  .bundle-builder__header { display: flex; flex-direction: column; }
  @media (max-width: 767.98px) {
    .bundle-builder { padding-block: var(--bundle-builder-padding-top-mobile, var(--bundle-builder-padding-top, 40px)) var(--bundle-builder-padding-bottom-mobile, var(--bundle-builder-padding-bottom, 40px)); }
    .bundle-builder__container { grid-template-columns: minmax(0, 1fr); grid-template-areas: "header" "image" "products" "cta"; --bundle-column-gap-current: var(--bundle-column-gap-mobile); --bundle-column-row-gap: var(--bundle-column-gap-mobile); }
    .bundle-builder__container:has(.bundle-builder__image--empty) { grid-template-areas: "header" "products" "cta"; }
    .bundle-builder__content { display: contents; }
    .bundle-builder__header { grid-area: header; }
    .bundle-builder__image { grid-area: image; }
    .bundle-builder__image[data-mobile-ratio="auto"] img { height: auto; }
    .bundle-builder__image { aspect-ratio: var(--bundle-image-ratio-mobile, auto); border-radius: var(--bundle-image-radius-mobile, var(--bundle-image-radius)); }
    .bundle-builder__image img { height: 100%; }
    .bundle-builder__image:not([data-mobile-ratio="auto"]) img { position: absolute; inset: 0; }
    .bundle-builder__content > .bundle-product-list { grid-area: products; min-width: 0; }
    .bundle-builder__content > .bundle-routine-cta { grid-area: cta; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Bundle builder",
  "class": "section-bundle-builder",
  "enabled_on": {
    "templates": [
      "index"
    ]
  },
  "blocks": [
    {
      "type": "header"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "t:general.image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:general.image"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        {
          "value": "auto",
          "label": "t:options.image_ratio.auto"
        },
        {
          "value": "square",
          "label": "t:options.image_ratio.square"
        },
        {
          "value": "portrait",
          "label": "t:options.image_ratio.portrait"
        },
        {
          "value": "landscape",
          "label": "t:options.image_ratio.landscape"
        },
        {
          "value": "wide",
          "label": "t:options.image_ratio.wide"
        },
        {
          "value": "custom",
          "label": "t:options.image_ratio.custom"
        }
      ],
      "default": "auto"
    },
    {
      "type": "number",
      "id": "image_ratio_custom_width",
      "label": "W",
      "default": 16,
      "visible_if": "{{ section.settings.image_ratio == 'custom' }}"
    },
    {
      "type": "number",
      "id": "image_ratio_custom_height",
      "label": "H",
      "default": 9,
      "visible_if": "{{ section.settings.image_ratio == 'custom' }}"
    },
    {
      "type": "select",
      "id": "corner_radius",
      "label": "t:labels.corner_radius",
      "options": [
        {
          "value": "inherit",
          "label": "t:options.radius_preset.inherit"
        },
        {
          "value": "square",
          "label": "t:options.radius_preset.square"
        },
        {
          "value": "rounded",
          "label": "t:options.radius_preset.rounded"
        },
        {
          "value": "full",
          "label": "t:options.radius_preset.full"
        },
        {
          "value": "custom",
          "label": "t:options.radius_preset.custom"
        }
      ],
      "default": "inherit"
    },
    {
      "type": "range",
      "id": "custom_corner_radius",
      "label": "t:labels.custom_corner_radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.corner_radius == 'custom' }}"
    },
    {
      "type": "checkbox",
      "id": "customize_mobile_image",
      "label": "Customize for mobile",
      "default": false
    },
    {
      "type": "select",
      "id": "image_ratio_mobile",
      "label": "t:labels.image_ratio_mobile",
      "options": [
        {
          "value": "auto",
          "label": "t:options.image_ratio.auto"
        },
        {
          "value": "square",
          "label": "t:options.image_ratio.square"
        },
        {
          "value": "portrait",
          "label": "t:options.image_ratio.portrait"
        },
        {
          "value": "landscape",
          "label": "t:options.image_ratio.landscape"
        },
        {
          "value": "wide",
          "label": "t:options.image_ratio.wide"
        },
        {
          "value": "custom",
          "label": "t:options.image_ratio.custom"
        }
      ],
      "default": "auto",
      "visible_if": "{{ section.settings.customize_mobile_image }}"
    },
    {
      "type": "number",
      "id": "image_ratio_custom_width_mobile",
      "label": "W (mobile)",
      "default": 16,
      "visible_if": "{{ section.settings.customize_mobile_image and section.settings.image_ratio_mobile == 'custom' }}"
    },
    {
      "type": "number",
      "id": "image_ratio_custom_height_mobile",
      "label": "H (mobile)",
      "default": 9,
      "visible_if": "{{ section.settings.customize_mobile_image and section.settings.image_ratio_mobile == 'custom' }}"
    },
    {
      "type": "select",
      "id": "corner_radius_mobile",
      "label": "Border radius (mobile)",
      "options": [
        {
          "value": "inherit",
          "label": "t:options.radius_preset.inherit"
        },
        {
          "value": "square",
          "label": "t:options.radius_preset.square"
        },
        {
          "value": "rounded",
          "label": "t:options.radius_preset.rounded"
        },
        {
          "value": "full",
          "label": "t:options.radius_preset.full"
        },
        {
          "value": "custom",
