{% liquid
  assign collection_list_container_width = 'page-width'
  if section.settings.section_width == 'full_width'
    assign collection_list_container_width = 'full-width'
  elsif section.settings.section_width == 'full_width_no_padding'
    assign collection_list_container_width = 'full-width full-width--no-padding'
  endif
  assign collection_list_max_width = section.settings.max_width | default: 1600 | plus: 0

  assign collection_list_scheme = section.settings.color_scheme | default: 'scheme-1'
  if section.settings.color_scheme.id != blank
    assign collection_list_scheme = section.settings.color_scheme.id
  endif
  assign collection_list_scheme = collection_list_scheme | default: 'scheme-1' | handleize

  assign collection_list_gap_desktop = section.settings.gap_desktop | default: 40 | plus: 0
  assign collection_list_gap_mobile = section.settings.gap_mobile | default: 30 | plus: 0
  assign collection_list_padding_top = section.settings.padding_top | default: 50 | plus: 0
  assign collection_list_padding_bottom = section.settings.padding_bottom | default: 50 | plus: 0
  assign collection_list_padding_top_mobile = section.settings.padding_top_mobile | default: collection_list_padding_top | plus: 0
  assign collection_list_padding_bottom_mobile = section.settings.padding_bottom_mobile | default: collection_list_padding_bottom | plus: 0
%}

{% capture collection_list_style %}
  {% if collection_list_gap_desktop != 40 %}--collection-list-gap: {{ collection_list_gap_desktop }}px;{% endif %}
  {% if collection_list_gap_mobile != 30 %}--collection-list-gap-mobile: {{ collection_list_gap_mobile }}px;{% endif %}
  {% if section.settings.background_media == 'color' and section.settings.background_color != blank %}--collection-list-background-color: {{ section.settings.background_color | escape }};{% endif %}
  {% if collection_list_padding_top != 50 %}--collection-list-padding-top: {{ collection_list_padding_top }}px;{% endif %}
  {% if collection_list_padding_bottom != 50 %}--collection-list-padding-bottom: {{ collection_list_padding_bottom }}px;{% endif %}
  {% if section.settings.customize_mobile_padding %}
    {% if collection_list_padding_top_mobile != collection_list_padding_top %}--collection-list-padding-top-mobile: {{ collection_list_padding_top_mobile }}px;{% endif %}
    {% if collection_list_padding_bottom_mobile != collection_list_padding_bottom %}--collection-list-padding-bottom-mobile: {{ collection_list_padding_bottom_mobile }}px;{% endif %}
  {% endif %}
{% endcapture %}
{% assign collection_list_style = collection_list_style | strip %}
{% capture collection_list_container_style %}
  {% if section.settings.section_width == 'full_width' or section.settings.section_width == 'full_width_no_padding' %}max-width: {{ collection_list_max_width }}px;{% endif %}
  {% if section.settings.section_width == 'full_width_no_padding' %}padding-inline: 0;{% endif %}
{% endcapture %}
{% assign collection_list_container_style = collection_list_container_style | strip %}

<div class="collection-list">
  <div
    class="section-spacing collection-list__spacing section-content-scope section-content-surface color-scheme section-color-scope {{ collection_list_scheme }}"
    {% if collection_list_style != blank %}style="{{ collection_list_style }}"{% endif %}
  >
    {% if section.settings.background_media != 'none' and section.settings.background_media != 'color' %}
      <div class="collection-list__background" aria-hidden="true">
        {% if section.settings.background_media == 'image' and section.settings.background_image != blank %}
          {{ section.settings.background_image | image_url: width: 2400 | image_tag: widths: '750, 1100, 1500, 2000, 2400', sizes: '100vw', alt: '' }}
        {% elsif section.settings.background_media == 'video' and section.settings.background_video != blank %}
          {{ section.settings.background_video | video_tag: autoplay: true, loop: true, muted: true, controls: false, image_size: '2400x' }}
        {% elsif section.settings.background_media != 'color' %}
          <div class="collection-list__background-placeholder placeholder-image">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>
    {% endif %}

    <div
      class="container {{ collection_list_container_width }} collection-list__container section-list-layout"
      {% if collection_list_container_style != blank %}style="{{ collection_list_container_style }}"{% endif %}
    >
      {% capture collection_list_content_content %}{% content_for 'block', type: 'collection-list-items', id: 'collection-list' %}{% endcapture %}
      {% render 'section-content-slot', content: collection_list_content_content, class: 'collection-list__content section-list-layout__body' %}
    </div>
  </div>
</div>

{% stylesheet %}
  .collection-list__spacing {
    width: 100%;
    padding-top: var(--collection-list-padding-top, 50px);
    padding-bottom: var(--collection-list-padding-bottom, 50px);
  }
  .collection-list__container {
    --section-list-gap: var(--collection-list-gap, 40px);
    --section-list-gap-mobile: var(--collection-list-gap-mobile, 30px);
  }

  .collection-list { width: 100%; min-width: 0; }
  .collection-list__spacing { position: relative; isolation: isolate; overflow: hidden; background-color: var(--collection-list-background-color, var(--background-color)); }
  .collection-list__background { position: absolute; z-index: -1; inset: 0; }
  .collection-list__background img, .collection-list__background video, .collection-list__background-placeholder { display: block; width: 100%; height: 100%; object-fit: cover; }
  .collection-list__container { position: relative; }
  .collection-list__container.full-width--no-padding { width: 100%; margin-inline: auto; }

  @media (max-width: 767.98px) {
    .collection-list__spacing {
      padding-top: var(--collection-list-padding-top-mobile, var(--collection-list-padding-top, 50px));
      padding-bottom: var(--collection-list-padding-bottom-mobile, var(--collection-list-padding-bottom, 50px));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collection_list",
  "class": "section-collection-list",
  "enabled_on": { "templates": ["*"] },
  "blocks": [
    { "type": "header" },
    { "type": "collection-list-items" }
  ],
  "settings": [
    {
      "type": "header",
      "content": "t:general.layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:labels.section_width",
      "options": [
        { "value": "page_width", "label": "t:options.section_width.page_width" },
        { "value": "full_width", "label": "t:options.section_width.full_width" },
        { "value": "full_width_no_padding", "label": "t:options.section_width.full_width_no_padding" }
      ],
      "default": "page_width"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "t:labels.max_width",
      "min": 1000,
      "max": 2000,
      "step": 10,
      "unit": "px",
      "default": 1600,
      "visible_if": "{{ section.settings.section_width == 'full_width' or section.settings.section_width == 'full_width_no_padding' }}"
    },
    {
      "type": "header",
      "content": "t:general.gap"
    },
    {
      "type": "range",
      "id": "gap_desktop",
      "label": "t:labels.desktop_gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "t:labels.mobile_gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 30
    },
    {
      "type": "header",
      "content": "t:general.appearance"
    },
    {
      "type": "select",
      "id": "background_media",
      "label": "t:general.media",
      "options": [
        { "value": "none", "label": "t:options.background_media.none" },
        { "value": "color", "label": "t:labels.color" },
        { "value": "image", "label": "t:general.image" },
        { "value": "video", "label": "t:general.video" }
      ],
      "default": "none"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:labels.background_color",
      "default": "#F7F4EF",
      "visible_if": "{{ section.settings.background_media == 'color' }}"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:labels.background_image",
      "visible_if": "{{ section.settings.background_media == 'image' }}"
    },
    {
      "type": "video",
      "id": "background_video",
      "label": "t:labels.background_video",
      "visible_if": "{{ section.settings.background_media == 'video' }}"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:general.padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.top_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.bottom_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 50
    },
    {
      "type": "checkbox",
      "id": "customize_mobile_padding",
      "label": "t:labels.customize_mobile_padding",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:labels.mobile_top_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 50,
      "visible_if": "{{ section.settings.customize_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:labels.mobile_bottom_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 50,
      "visible_if": "{{ section.settings.customize_mobile_padding }}"
    }
  ],
  "presets": [
    {
      "name": "t:general.collection_list",
      "category": "t:general.collections",
      "blocks": [
        { "type": "collection-list-items", "id": "collection-list", "static": true, "blocks": [{ "type": "collection-card", "id": "collection-card", "static": true, "settings": { "ratio": "custom", "ratio_custom_width": 9, "ratio_custom_height": 10, "placement": "on_image", "alignment": "center", "media_corner_radius": "radius_8", "color_type": "inherit", "gap_desktop": 20, "gap_mobile": 20, "padding_top": 16, "padding_bottom": 16, "padding_left": 16, "padding_right": 16, "show_overlay": true, "overlay_background": "linear-gradient(180deg, rgba(0, 0, 0, 0) 30%, rgba(0, 0, 0, 0.4772) 100%)" }, "blocks": [{ "type": "collection-card-title", "id": "title", "static": true, "settings": { "heading_size": "md", "html_tag": "h3" } }, { "type": "collection-card-button", "settings": { "button_label": "Show Now", "button_style": "primary", "width": "fit" } }] }] }
      ]
    }
  ]
}
{% endschema %}
