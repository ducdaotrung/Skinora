{% liquid
  assign community_scheme = section.settings.color_scheme | default: 'scheme-4'
  if section.settings.color_scheme.id != blank
    assign community_scheme = section.settings.color_scheme.id
  endif
%}
<section class="community-video-carousel section-color-scope {{ community_scheme | handleize }}" data-community-videos style="--community-background:{{ section.settings.background_color | default: 'var(--background-color)' }}; --community-padding-top:{{ section.settings.padding_top }}px; --community-padding-bottom:{{ section.settings.padding_bottom }}px; --community-padding-top-mobile:{{ section.settings.padding_top_mobile }}px; --community-padding-bottom-mobile:{{ section.settings.padding_bottom_mobile }}px;">
<div class="container page-width community-video-carousel__content">
{% content_for 'blocks' %}
</div></section>
{% stylesheet %}
.community-video-carousel { padding-top:var(--community-padding-top,80px); padding-bottom:var(--community-padding-bottom,80px); overflow:hidden; background-color:var(--community-background,#fbf8f4); }
.community-video-carousel__content { display:flex; flex-direction:column; gap:67px; }
.community-video-carousel [data-carousel-block] { --carousel-preview-size: 15%; }
.community-video-carousel .carousel-block__viewport[data-swiper-next-slide-preview='true'] { overflow:visible; clip-path:inset(0 -15% 0 -15%); }
.community-video-carousel .carousel-block__viewport > .swiper-wrapper { align-items:center; }
.community-video-carousel .community-video-card { height:auto; }
.community-video-carousel .community-video-card { container-type:inline-size; }
.community-video-carousel .community-video-card.swiper-slide-active > .community-video-card__media { overflow:visible; }
.community-video-carousel .community-video-card.swiper-slide-active .video-block__media { height:calc(133.333cqw + 50px); aspect-ratio:auto; }
.community-video-carousel .community-video-card__media,
.community-video-carousel .video-block__media { border-radius:16px; }
.community-video-carousel .video__play { width:auto; height:auto; border-radius:0; color:#fff; background:transparent; }
.community-video-carousel .video__play svg { width:32px; height:32px; margin:0; color:#fff; fill:currentColor; }
.community-video-carousel .video__play-icon,
.community-video-carousel .video__pause-icon { width:32px; height:32px; grid-area:1 / 1; }
.community-video-carousel .video__play { width:48px; height:48px; inset:50% auto auto 50%; transform:translate(-50%,-50%); }
.community-video-carousel .video__play-icon svg path { fill:currentColor; stroke:none; }
.community-video-carousel .video__placeholder { background-color:#eeece9; }
.community-video-carousel .carousel-block__pagination--bullets {
  --swiper-pagination-bullet-width: 8px;
  --swiper-pagination-bullet-height: 8px;
  --swiper-pagination-bullet-active-width: 8px;
  --swiper-pagination-bullet-active-height: 8px;
  --swiper-pagination-bullet-hit-width: 24px;
  --swiper-pagination-bullet-hit-size: 24px;
  --swiper-pagination-bullet-active-hit-width: 24px;
  --swiper-pagination-bullet-gap: 0px;
}
[data-community-videos].community-video-carousel .swiper .swiper-pagination.carousel-block__pagination--bullets .swiper-pagination-bullet-active::before {
  background: #000;
}
[data-community-videos].community-video-carousel .swiper .swiper-pagination.carousel-block__pagination--bullets .swiper-pagination-bullet-active::after {
  display: none;
  animation: none;
}
@media(max-width:767.98px) { .community-video-carousel { padding-top:var(--community-padding-top-mobile,56px); padding-bottom:var(--community-padding-bottom-mobile,56px); } .community-video-carousel__content { gap:53px; } }
{% endstylesheet %}
