{% liquid
  assign custom_section_alignment = 'start'
  case section.settings.alignment
    when 'center'
      assign custom_section_alignment = 'center'
    when 'right'
      assign custom_section_alignment = 'end'
  endcase

  assign custom_section_alignment_mobile = custom_section_alignment
  if section.settings.customize_mobile_alignment
    assign custom_section_alignment_mobile = 'start'
    case section.settings.alignment_mobile
      when 'center'
        assign custom_section_alignment_mobile = 'center'
      when 'right'
        assign custom_section_alignment_mobile = 'end'
    endcase
  endif

  assign padding_top = section.settings.padding_top | default: 0 | plus: 0
  assign custom_section_max_width = section.settings.max_width | default: 1200 | plus: 0
  if custom_section_max_width < 200 or custom_section_max_width > 2200
    assign custom_section_max_width = 1200
  endif
  assign padding_bottom = section.settings.padding_bottom | default: 0 | plus: 0
  assign padding_left = section.settings.padding_left | default: 0 | plus: 0
  assign padding_right = section.settings.padding_right | default: 0 | plus: 0
  assign padding_left_mobile = section.settings.padding_left_mobile | default: 0 | plus: 0
  assign padding_right_mobile = section.settings.padding_right_mobile | default: 0 | plus: 0
  assign padding_top_mobile = section.settings.padding_top_mobile | default: 0 | plus: 0
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile | default: 0 | plus: 0
  assign custom_section_gap_desktop = section.settings.content_gap | default: 16 | plus: 0
  assign custom_section_gap_mobile = custom_section_gap_desktop
  if section.settings.customize_mobile_gap
    assign custom_section_gap_mobile = section.settings.content_gap_mobile | default: custom_section_gap_desktop | plus: 0
  endif

  assign custom_section_width = 'page-width'
  assign custom_section_container_width = 'page-width'
  case section.settings.section_width
    when 'full_width'
      assign custom_section_width = 'full-width'
      assign custom_section_container_width = 'full-width'
    when 'full_width_no_padding'
      assign custom_section_width = 'full-width-no-padding'
      assign custom_section_container_width = 'full-width'
  endcase

  assign custom_section_scheme = section.settings.color_scheme | default: 'scheme-1'
  if section.settings.color_scheme.id != blank
    assign custom_section_scheme = section.settings.color_scheme.id
  endif
  assign custom_section_scheme = custom_section_scheme | default: 'scheme-1' | handleize
%}

{% capture custom_section_style %}
  {% if section.settings.limit_width %}--custom-section-max-width: {{ custom_section_max_width }}px;{% endif %}
  {% if custom_section_alignment != 'start' %}--flex-align: {{ custom_section_alignment }};{% endif %}
  {% if section.settings.customize_mobile_alignment and custom_section_alignment_mobile != custom_section_alignment %}--flex-align-mobile: {{ custom_section_alignment_mobile }};{% endif %}
  {% if section.settings.background_color != blank %}--custom-section-background-color: {{ section.settings.background_color | escape }};{% endif %}
  {% if padding_top != 0 %}--custom-section-padding-top: {{ padding_top }}px;{% endif %}
  {% if padding_bottom != 0 %}--custom-section-padding-bottom: {{ padding_bottom }}px;{% endif %}
  {% if padding_left != 0 %}--custom-section-padding-left: {{ padding_left }}px;{% endif %}
  {% if padding_right != 0 %}--custom-section-padding-right: {{ padding_right }}px;{% endif %}
  {% if section.settings.customize_mobile_padding %}
    --custom-section-padding-left-mobile: {{ padding_left_mobile }}px;
    --custom-section-padding-right-mobile: {{ padding_right_mobile }}px;
    {% if padding_top_mobile != padding_top %}--custom-section-padding-top-mobile: {{ padding_top_mobile }}px;{% endif %}
    {% if padding_bottom_mobile != padding_bottom %}--custom-section-padding-bottom-mobile: {{ padding_bottom_mobile }}px;{% endif %}
  {% endif %}
{% endcapture %}
{% assign custom_section_style = custom_section_style | strip %}

{% capture custom_section_content_style %}
  {% render 'layout-flow-style',
    direction: 'column',
    wrap: 'nowrap',
    align_items: 'var(--flex-align, flex-start)',
    align_items_mobile: 'var(--flex-align-mobile, var(--flex-align, flex-start))',
    gap: custom_section_gap_desktop,
    gap_mobile: custom_section_gap_mobile
  %}
{% endcapture %}
{% assign custom_section_content_style = custom_section_content_style | strip %}

<div
  class="custom-section custom-section--{{ custom_section_width }}"
>
  <div
    class="section-spacing custom-section__spacing color-scheme section-color-scope {{ custom_section_scheme }}"
    {% if custom_section_style != blank %}style="{{ custom_section_style }}"{% endif %}
  >
    {% if section.settings.background_image != blank %}
      <div class="custom-section__background" aria-hidden="true">
        {{ section.settings.background_image | image_url: width: 2000 | image_tag }}
      </div>
    {% endif %}

    <div class="container {{ custom_section_container_width }} custom-section__container">
      <div class="custom-section__content layout-flow layout-flow--responsive align-content" style="{{ custom_section_content_style }}">
        {% content_for 'blocks' %}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .custom-section {
    width: 100%;
    min-width: 0;
  }
  .custom-section__spacing {
    position: relative;
    overflow: clip;
    width: 100%;
    padding-top: var(--custom-section-padding-top, 0px);
    padding-bottom: var(--custom-section-padding-bottom, 0px);
    background-color: var(--custom-section-background-color, var(--background-color));
  }
  .custom-section__container {
    position: relative;
    z-index: 1;
  }
  .custom-section--full-width-no-padding .container.custom-section__container {
    --page-margin-current: 0px;
    padding-inline: 0;
  }
  .custom-section__background {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }
  .custom-section__background img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .custom-section__content {
    min-width: 0;
    width: 100%;
    max-width: var(--custom-section-max-width, none);
    margin-inline: auto;
    padding-left: var(--custom-section-padding-left, 0px);
    padding-right: var(--custom-section-padding-right, 0px);
  }

  /* Saved Testimonial (custom) instance: keep its inline columns content-sized. */
  [id$='__custom_section_YtzgEx'] .block-row > .block-column--width-fill {
    --flex-align: center;
    --flex-align-mobile: center;
    align-items: center;
    text-align: center;
  }

  [id$='__custom_section_YtzgEx'] .block-row > .block-column--width-fill > :is(.heading-block, .text-block) {
    text-align: center;
  }

  [id$='__custom_section_YtzgEx'] .block-row > .block-column {
    flex: 0 1 auto;
    width: fit-content;
    min-width: 0;
    max-width: fit-content;
  }

  [id$='__custom_section_YtzgEx'] .block-row > .block-column > .size-style {
    width: fit-content;
    max-width: fit-content;
  }

  @media (max-width: 767.98px) {
    [id$='__custom_section_YtzgEx'] .block-row {
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: center;
    }

    [id$='__custom_section_YtzgEx'] .block-row > :is(.block-column--width-fill, .block-column--width-fit) > .image-block {
      width: var(--size-style-max-width-mobile, var(--size-style-max-width, fit-content));
    }

    .custom-section__content {
      padding-left: var(--custom-section-padding-left-mobile, var(--custom-section-padding-left, 0px));
      padding-right: var(--custom-section-padding-right-mobile, var(--custom-section-padding-right, 0px));
    }
    .custom-section__spacing {
      padding-top: var(--custom-section-padding-top-mobile, var(--custom-section-padding-top, 0px));
      padding-bottom: var(--custom-section-padding-bottom-mobile, var(--custom-section-padding-bottom, 0px));
    }
  }
{% endstylesheet %}

