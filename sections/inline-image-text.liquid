{% liquid
  assign inline_image_text_alignment = 'start'
  case section.settings.alignment
    when 'center'
      assign inline_image_text_alignment = 'center'
    when 'right'
      assign inline_image_text_alignment = 'end'
  endcase

  assign inline_image_text_alignment_mobile = inline_image_text_alignment
  if section.settings.customize_mobile_alignment
    assign inline_image_text_alignment_mobile = 'start'
    case section.settings.alignment_mobile
      when 'center'
        assign inline_image_text_alignment_mobile = 'center'
      when 'right'
        assign inline_image_text_alignment_mobile = 'end'
    endcase
  endif

  assign padding_top = section.settings.padding_top | default: 0 | plus: 0
  assign padding_bottom = section.settings.padding_bottom | default: 0 | plus: 0
  assign padding_top_mobile = section.settings.padding_top_mobile | default: 0 | plus: 0
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile | default: 0 | plus: 0

  assign inline_image_text_container_width = 'page-width'
  case section.settings.section_width
    when 'full_width'
      assign inline_image_text_container_width = 'full-width'
  endcase

  assign inline_image_text_scheme = section.settings.color_scheme | default: 'scheme-1'
  if section.settings.color_scheme.id != blank
    assign inline_image_text_scheme = section.settings.color_scheme.id
  endif
  assign inline_image_text_scheme = inline_image_text_scheme | default: 'scheme-1' | handleize
%}

{% capture inline_image_text_style %}
  --inline-image-text-align: {{ section.settings.alignment | default: 'center' }};
  {% if section.settings.customize_mobile_alignment %}--inline-image-text-align-mobile: {{ section.settings.alignment_mobile | default: 'center' }};{% endif %}
  {% if inline_image_text_alignment != 'start' %}--flex-align: {{ inline_image_text_alignment }};{% endif %}
  {% if section.settings.customize_mobile_alignment and inline_image_text_alignment_mobile != inline_image_text_alignment %}--flex-align-mobile: {{ inline_image_text_alignment_mobile }};{% endif %}
  {% if section.settings.background_color != blank %}--inline-image-text-background-color: {{ section.settings.background_color | escape }};{% endif %}
  {% if padding_top != 0 %}--inline-image-text-padding-top: {{ padding_top }}px;{% endif %}
  {% if padding_bottom != 0 %}--inline-image-text-padding-bottom: {{ padding_bottom }}px;{% endif %}
  {% if section.settings.customize_mobile_padding %}
    {% if padding_top_mobile != padding_top %}--inline-image-text-padding-top-mobile: {{ padding_top_mobile }}px;{% endif %}
    {% if padding_bottom_mobile != padding_bottom %}--inline-image-text-padding-bottom-mobile: {{ padding_bottom_mobile }}px;{% endif %}
  {% endif %}
{% endcapture %}
{% assign inline_image_text_style = inline_image_text_style | strip %}

{% capture inline_image_text_content_style %}
  {% render 'layout-flow-style',
    direction: 'column',
    wrap: 'nowrap',
    align_items: 'var(--flex-align, flex-start)',
    align_items_mobile: 'var(--flex-align-mobile, var(--flex-align, flex-start))',
    gap_value: 'var(--layout-grid-gap, 1rem)',
    gap_mobile_value: 'var(--layout-grid-gap, 1rem)'
  %}
{% endcapture %}
{% assign inline_image_text_content_style = inline_image_text_content_style | strip %}

<div
  class="section-spacing inline-image-text__spacing color-scheme section-color-scope {{ inline_image_text_scheme }}"
  {% if inline_image_text_style != blank %}style="{{ inline_image_text_style }}"{% endif %}
>
  {% if section.settings.background_image != blank %}
    <div class="inline-image-text__background" aria-hidden="true">
      {{ section.settings.background_image | image_url: width: 2000 | image_tag }}
    </div>
  {% endif %}

  <div class="container {{ inline_image_text_container_width }} inline-image-text__container">
    <div class="inline-image-text__content layout-flow layout-flow--responsive align-content" style="{{ inline_image_text_content_style }}">
      {% content_for "block", type: "text", id: "text" %}
      {% content_for "block", type: "inline-image-heading", id: "editorial-text" %}
      {% content_for "blocks" %}
    </div>
  </div>
</div>

{% stylesheet %}
  .inline-image-text__spacing {
    position: relative;
    overflow: hidden;
    width: 100%;
    padding-top: var(--inline-image-text-padding-top, 0px);
    padding-bottom: var(--inline-image-text-padding-bottom, 0px);
    background-color: var(--inline-image-text-background-color, var(--background-color));
  }

  .inline-image-text__background {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .inline-image-text__background img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .inline-image-text__container {
    position: relative;
    z-index: 1;
  }

  .inline-image-text__content {
    min-width: 0;
    color: var(--body-color);
    overflow-wrap: anywhere;
    --text-align-default: var(--inline-image-text-align, center);
    text-align: var(--text-align-default);
  }

  .inline-image-text__content :where(ul, ol) {
    padding-inline-start: 1.5em;
  }

  .inline-image-text__content :where(img, video, iframe) {
    max-width: 100%;
  }

  .inline-image-text__content a {
    color: inherit;
  }

  @media (max-width: 767.98px) {
    .inline-image-text__content { --text-align-default: var(--inline-image-text-align-mobile, var(--inline-image-text-align, center)); }
    .inline-image-text__spacing {
      padding-top: var(--inline-image-text-padding-top-mobile, var(--inline-image-text-padding-top, 0px));
      padding-bottom: var(--inline-image-text-padding-bottom-mobile, var(--inline-image-text-padding-bottom, 0px));
    }
  }
  .inline-image-text__content .editorial-text-block { line-height: 2.8; }
  .inline-image-text__content .editorial-text-block p { margin: 0; }
  .inline-image-text__content .editorial-text-block__image { aspect-ratio: 1; overflow: hidden; margin-inline: .25em; }
  .inline-image-text__content .editorial-text-block__image :is(a, img, svg, .placeholder-image) { height: 100%; aspect-ratio: 1; object-fit: cover; }
{% endstylesheet %}

{% schema %}
{
  "name": "Inline image text",
  "class": "section-inline-image-text",
  "enabled_on": {
    "templates": [
      "*"
    ]
  },
  "blocks": [
    {
      "type": "button"
    },
    {
      "type": "buttons"
    },
    {
      "type": "collection-card-button"
    },
    {
      "type": "collection-card-description"
    },
    {
      "type": "collection-card-title"
    },
    {
      "type": "countdown-timer"
    },
    {
      "type": "divider"
    },
    {
      "type": "editorial-text"
    },
    {
      "type": "eyebrow"
    },
    {
      "type": "header"
    },
    {
      "type": "heading"
    },
    {
      "type": "icon"
    },
    {
      "type": "image"
    },
    {
      "type": "inline-image-heading"
    },
    {
      "type": "scroll-to"
    },
    {
      "type": "text"
    },
    {
      "type": "video"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "t:general.layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:labels.section_width",
      "options": [
        {
          "value": "page_width",
          "label": "t:options.section_width.page_width"
        },
        {
          "value": "full_width",
          "label": "t:options.section_width.full_width"
        }
      ],
      "default": "page_width"
    },
    {
      "type": "text_alignment",
      "id": "alignment",
      "label": "t:labels.alignment",
      "default": "center"
    },
    {
      "type": "checkbox",
      "id": "customize_mobile_alignment",
      "label": "t:labels.customize_mobile_alignment",
      "default": false
    },
    {
      "type": "text_alignment",
      "id": "alignment_mobile",
      "label": "t:labels.mobile_alignment",
      "default": "center",
      "visible_if": "{{ section.settings.customize_mobile_alignment }}"
    },
    {
      "type": "header",
      "content": "t:general.appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "background_color",
      "label": "t:labels.background"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:labels.background_image"
    },
    {
      "type": "header",
      "content": "t:general.padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.top_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.bottom_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "checkbox",
      "id": "customize_mobile_padding",
      "label": "t:labels.customize_mobile_padding",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:labels.mobile_top_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.customize_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:labels.mobile_bottom_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.customize_mobile_padding }}"
    }
  ],
  "presets": [
    {
      "settings": {
        "color_scheme": "scheme-1",
        "padding_top": 40,
        "alignment": "center",
        "padding_bottom": 40
      },
      "name": "Inline image text",
      "blocks": [
        {
          "settings": {
            "text": "<p>EMPOWER YOUR SKIN CARE</p>",
            "text_size": "display"
          },
          "id": "text",
          "static": true,
          "type": "text"
        },
        {
          "settings": {
            "image_width_mobile_3": 64,
            "max_width": 900,
            "image_width_2": 90,
            "image_width_3": 90,
            "image_width_1": 90,
            "text": "<p>Beauty Is About [img1] Enhancing What [img2] You Have.</p><p>Let Yourself [img3] Shine Through.</p>",
            "show_image_1": true,
            "image_width_mobile_2": 64,
            "font_size": 24,
            "image_width_mobile_1": 64,
            "width": "custom",
            "show_image_3": true,
            "size": "display",
            "show_image_2": true,
            "corner_radius": "full",
            "html_tag": "h2"
          },
          "id": "editorial-text",
          "static": true,
          "type": "inline-image-heading"
        }
      ],
      "category": "Storytelling"
    }
  ]
}
{% endschema %}
