{% comment %}
  This section is used in the password template to render landing page shown
  when password protection is applied to a store.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/password
{% endcomment %}

<div class="container page-width section-color-scope body-text body-md {{ section.settings.color_scheme | default: 'scheme-1' }}">
  <h1 class="heading-text heading-xl">{{ 'password.title' | t }}</h1>

  {% if shop.password_message %}
    <p>{{ shop.password_message }}</p>
  {% endif %}

  {% form 'storefront_password' %}
    <div class="form__wrapper">
      {% if form.errors %}
        <div class="form__error" role="alert">{{ form.errors | default_errors }}</div>
      {% endif %}

      <div class="form__fields">
        <div class="form__field">
          <label class="form__label" for="password-input">
            {{ 'password.password' | t }}
          </label>

          <input class="form__control form__control--input" type="password" name="password" id="password-input" autocomplete="current-password">
        </div>

        <button class="btn btn--primary" type="submit">
          {{ 'password.enter' | t }}
        </button>
      </div>
    </div>
  {% endform %}
</div>

{% schema %}
{
  "name": "t:general.password",
  "enabled_on": { "templates": ["password"] },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
